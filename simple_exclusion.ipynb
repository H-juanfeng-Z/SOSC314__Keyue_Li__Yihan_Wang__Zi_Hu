# -*- coding: utf-8 -*-
"""
Preliminary Data Exclusion (beginner version)
Dataset: "Python Questions from Stack Overflow" (Kaggle: stackoverflow/pythonquestions)

What this script does, step by step:
  Step 1. Read the three CSV files (the two big ones are read in chunks)
  Step 2. Check for duplicate records        (same ID, or identical row)
  Step 3. Check for missing key fields       (ID, date, body)
  Step 4. Check the timestamps               (broken dates, future dates)
  Step 5. Find "time-inverted" answers       (answer earlier than its question)
  Step 6. Find orphan tags                   (tag pointing to a missing question)
  Step 7. Print a summary and save the excluded IDs

How to run: put this file together with Questions.csv, Answers.csv, Tags.csv
in one folder, then run:  python simple_exclusion.py
"""

import pandas as pd

# ============ Step 0: file paths (edit if needed) ============
QUESTIONS_CSV = "Questions.csv"
ANSWERS_CSV   = "Answers.csv"
TAGS_CSV      = "Tags.csv"
OUTPUT_CSV    = "excluded_records.csv"

# The dataset was exported in October 2019, so any later date is impossible.
EXPORT_DATE = pd.Timestamp("2019-10-08", tz="UTC")

CHUNK = 150000  # read 150,000 rows at a time (the files are too big to read at once)


# ============ Step 1-4: scan one big CSV file ============
def check_file(filename, is_question):
    """Read a big CSV piece by piece and count the problems.

    Returns a small table with only the light columns we still need,
    plus a dictionary of problem counts.
    """
    counts = {"total": 0, "dup_id": 0, "dup_row": 0, "missing_id": 0,
              "missing_body": 0, "bad_date": 0, "future_date": 0, "bad_score": 0}
    small_parts = []   # we keep only the small columns, never the big Body text

    reader = pd.read_csv(filename, dtype=str, chunksize=CHUNK,
                         keep_default_na=False,        # keep empty cells as ""
                         encoding="utf-8",
                         encoding_errors="replace")    # don't crash on rare broken characters

    for piece in reader:                     # handle one chunk at a time
        counts["total"] += len(piece)

        # --- duplicates: give every row a "fingerprint" (a hash number).
        # Two rows with the same fingerprint are completely identical.
        piece["fingerprint"] = pd.util.hash_pandas_object(piece, index=False)

        # --- missing values in key fields
        counts["missing_id"]   += (piece["Id"].str.strip() == "").sum()
        counts["missing_body"] += (piece["Body"].str.strip() == "").sum()

        # --- timestamps: turn the text into real dates.
        # "coerce" means: if a date is broken, turn it into NaT (Not a Time).
        piece["CreationDate"] = pd.to_datetime(piece["CreationDate"],
                                               errors="coerce", utc=True)
        counts["bad_date"]    += piece["CreationDate"].isna().sum()
        counts["future_date"] += (piece["CreationDate"] > EXPORT_DATE).sum()

        # --- score must be a number
        piece["Score"] = pd.to_numeric(piece["Score"], errors="coerce")
        counts["bad_score"] += piece["Score"].isna().sum()

        # keep only the small columns and move to the next chunk
        keep_cols = ["Id", "fingerprint", "CreationDate", "Score"]
        if not is_question:
            keep_cols.append("ParentId")
        small_parts.append(piece[keep_cols])

    small = pd.concat(small_parts, ignore_index=True)

    # now that all chunks are together, count duplicates on the small table
    counts["dup_id"]  = small["Id"].duplicated().sum()
    counts["dup_row"] = small["fingerprint"].duplicated().sum()
    return small, counts


# ============ run the checks on Questions and Answers ============
print("Checking Questions.csv ...")
questions, q_counts = check_file(QUESTIONS_CSV, is_question=True)

print("Checking Answers.csv ...")
answers, a_counts = check_file(ANSWERS_CSV, is_question=False)

# Tags.csv is small, so we read it in one go.
tags = pd.read_csv(TAGS_CSV, dtype=str, keep_default_na=False,
                   encoding="utf-8", encoding_errors="replace")
t_counts = {
    "total":     len(tags),
    "dup_row":   tags.duplicated().sum(),                # identical (Id, Tag) rows
    "missing":   (tags["Id"].str.strip() == "").sum()
               + (tags["Tag"].str.strip() == "").sum(),
}


# ============ Step 5: answers that are OLDER than their question ============
# Attach each answer to its parent question and compare the two dates.
merged = answers.merge(
    questions[["Id", "CreationDate"]].rename(
        columns={"Id": "ParentId", "CreationDate": "QuestionDate"}),
    on="ParentId", how="left")

bad_time = merged[merged["CreationDate"] < merged["QuestionDate"]]
orphan_answers = merged[merged["QuestionDate"].isna()]   # parent question missing


# ============ Step 6: tags pointing to questions that do not exist ============
question_ids = set(questions["Id"])
orphan_tags = tags[~tags["Id"].isin(question_ids)]


# ============ Step 7: print the summary ============
print("\n===== PRELIMINARY EXCLUSION SUMMARY =====")
print(f"Raw records:                 {q_counts['total']:>10,} questions"
      f" {a_counts['total']:>12,} answers {t_counts['total']:>12,} tags")
print(f"Duplicates / missing / bad dates removed:  "
      f"{q_counts['dup_id'] + q_counts['dup_row'] + q_counts['missing_id'] + q_counts['missing_body'] + q_counts['bad_date'] + q_counts['future_date']} questions, "
      f"{a_counts['dup_id'] + a_counts['dup_row'] + a_counts['missing_id'] + a_counts['missing_body'] + a_counts['bad_date'] + a_counts['future_date']} answers")
print(f"Time-inverted answers removed:  {len(bad_time)}")
print(f"Orphan answers removed:         {len(orphan_answers)}")
print(f"Orphan tags removed:            {len(orphan_tags)}")
print(f"Kept for analysis:             {q_counts['total']:>10,} questions"
      f" {a_counts['total'] - len(bad_time) - len(orphan_answers):>12,} answers"
      f" {t_counts['total'] - len(orphan_tags):>12,} tags")
print("\nDetail counts:")
print("  Questions:", q_counts)
print("  Answers:  ", a_counts)
print("  Tags:     ", t_counts)

# save the excluded IDs so teammates can double-check
out = bad_time[["Id", "ParentId", "CreationDate", "QuestionDate"]].copy()
out.columns = ["AnswerId", "ParentQuestionId", "AnswerCreationDate", "QuestionCreationDate"]
with open(OUTPUT_CSV, "w") as f:
    f.write("# Answers created BEFORE their parent question (excluded)\n")
out.to_csv(OUTPUT_CSV, index=False, mode="a")
with open(OUTPUT_CSV, "a") as f:
    f.write("\n# Tags whose question does not exist (excluded)\nQuestionId,Tag\n")
orphan_tags.to_csv(OUTPUT_CSV, index=False, header=False, mode="a")
print(f"\nExcluded record IDs saved to: {OUTPUT_CSV}")
